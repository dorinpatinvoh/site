# ============================================================
#  Copie ce fichier vers `.env` puis remplis les valeurs :
#      cp .env.example .env
#  Le fichier .env est ignoré par Git : tes identifiants ne
#  partent jamais dans le dépôt.
# ============================================================

# --- 1. Le compte (OBLIGATOIRE) -------------------------------------
BOT_NUMERO=22900000000
BOT_MOT_DE_PASSE=ton-mot-de-passe
BOT_URL_SITE=https://exemple.com

# --- 2. Aiguillage (facultatif, autodétection sinon) ----------------
# Laisse vide : le script cherche lui-même la page de connexion,
# le champ numéro, le champ mot de passe et le bouton.
BOT_URL_CONNEXION=
BOT_URL_APRES_CONNEXION=
BOT_CHAMP_NUMERO=
BOT_CHAMP_MOT_DE_PASSE=
BOT_BOUTON_CONNEXION=

# Page privée à vérifier juste après le login (fiabilise le test
# de connexion). Exemple : https://exemple.com/tableau-de-bord
# BOT_URL_APRES_CONNEXION=https://exemple.com/tableau-de-bord

# --- 3. Le cerveau IA (à brancher plus tard) -------------------------
# Tant que IA_CLE_API est vide, le bot se connecte puis s'arrête.
IA_CLE_API=
IA_MODELE=gpt-4o-mini
# Toute API compatible OpenAI fonctionne :
#   OpenAI      https://api.openai.com/v1/chat/completions
#   Groq        https://api.groq.com/openai/v1/chat/completions
#   Mistral     https://api.mistral.ai/v1/chat/completions
#   OpenRouter  https://openrouter.ai/api/v1/chat/completions
#   Ollama      http://localhost:11434/v1/chat/completions
IA_URL_API=https://api.openai.com/v1/chat/completions
IA_INSTRUCTIONS=

# --- 4. Réglages ------------------------------------------------------
BOT_MAX_TOURS=25
BOT_DELAI_ACTIONS=1.0
# "http" (léger, par défaut) ou "navigateur" (Chromium + Playwright,
# nécessaire si le site exige du JavaScript)
BOT_BACKEND=http
